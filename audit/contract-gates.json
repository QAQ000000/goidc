        "node --test scripts/channel-components.test.mjs scripts/module-manifest.test.mjs scripts/release-candidate.test.mjs scripts/release-runtime.test.mjs"
      ],
      "evaluation": [
        "isolated PostgreSQL 18 credentials, audit rollback and historical payment compatibility",
        "browser configuration and deployment-specific external channel verification"
      ],
      "review": {
        "required": true,
        "owners": [
          "module",
          "store",
          "web",
          "release"
        ]
      },
      "releaseEvidence": {
        "required": true,
        "kind": "isolated-pg-and-compiled-module-manifest"
