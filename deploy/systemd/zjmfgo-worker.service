[Unit]
Description=ZJMF Go provision worker
After=network.target zjmfgo-api.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/zjmfgo
EnvironmentFile=/www/wwwroot/zjmfgo/.env
ExecStart=/www/wwwroot/zjmfgo/bin/zjmfgo-worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
