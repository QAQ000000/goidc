[Unit]
Description=ZJMF Go API development instance
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/zjmfgo
EnvironmentFile=/www/wwwroot/zjmfgo/.env
ExecStart=/www/wwwroot/zjmfgo/bin/zjmfgo-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
