HTTP_ADDR=127.0.0.1:8088
DATABASE_URL=postgres://zjmfgo_app:REPLACE_ME@127.0.0.1:5432/zjmfgo_dev?sslmode=disable
PUBLIC_ORIGIN=http://localhost:3088
# Optional comma-separated browser origins accepted by the API, for example a local proxy port.
PUBLIC_ORIGINS=
# Marks the session and captcha cookies Secure. Accepts true/false, 1/0, yes/no,
# on/off (case-insensitive); an unrecognized value aborts startup instead of
# silently disabling protection. When PUBLIC_ORIGIN uses https:// the API
# refuses to start unless this is enabled, because cookies would otherwise be
# sent over plain HTTP.
COOKIE_SECURE=false
# Optional comma-separated CIDR list of reverse proxies whose X-Forwarded-For /
# X-Real-IP headers may be trusted for rate limiting, blacklists and audit
# logs. Empty (the default) ignores forwarded headers entirely and always uses
# the TCP peer. Only list proxies you operate; the right-most address not in
# this list is treated as the client.
# Production: route /api/ directly from a controlled reverse proxy to Go.
# Next's local /api rewrite strips caller IP headers and uses the socket peer.
TRUSTED_PROXY_CIDRS=
# CAPTCHA implementation/profile; credentials remain server-only JSON.
# builtin is always available. Additional implementations must be compiled in.
CAPTCHA_DEFAULT=builtin
CAPTCHA_PROFILES=
BOOTSTRAP_USERNAME=root
BOOTSTRAP_EMAIL=root@example.com
BOOTSTRAP_PASSWORD=REPLACE_ME
API_INTERNAL_URL=http://127.0.0.1:8088
PAYMENT_GATEWAY_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX
PAYMENT_MOCK_ENABLED=false
# Optional legacy 易支付 adapter. Keep credentials in deployment environment only.
EPAY_API_URL=
EPAY_PID=
EPAY_KEY=
EPAY_TYPES=
# Optional 32-byte AES-GCM key encoded as 64 hex characters. Required to enable MFA.
MFA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX
PURCHASE_FIELD_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX
# Optional SMTP delivery for verification codes and future notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
# implicit_tls for port 465, starttls for 587, or none for an explicitly unauthenticated local relay.
SMTP_TLS_MODE=
# Optional NOKVM profiles. JSON lives only in the server environment; the API
# exposes profile ids/names. HTTPS is required except for loopback fixtures.
NOKVM_PROFILES=
# Application files: database compatibility until an explicit local/S3 profile is selected.
# Same profile ids/locations must remain available to both API and worker.
FILE_STORAGE_DEFAULT=database
FILE_STORAGE_PROFILES=
# Separate 32-byte AES-GCM key, 64 hex characters. Required for EasyPay intents
# and admin credentials. Retain it to decrypt historical payment snapshots.
PROVISION_ENCRYPTION_KEY=
# Optional read-only legacy import file root. Used only by legacy-import.
LEGACY_UPLOAD_ROOT=
# Optional old ThinkCMF database.authcode. When set during cutover, imported
# customer hashes support one successful login before upgrading to bcrypt.
LEGACY_CMF_AUTHCODE=
